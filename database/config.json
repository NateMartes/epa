{
  "collections": [
    {
      "name": "users",
      "indexes": [
        { "field": "user_id", "unique": true},
        {"field": "google_id", "unique": true, "sparse": true}
      ]
    },
    {
      "name": "session_tokens",
      "indexes": [
        {"field": "session_token", "expireAfterSeconds": 604800},
        {"field": "user_id", "unique": true}
      ]
    },
    {
      "name": "posts",
      "indexes": [
        {"field": "created_at"},
        {"compound": true, "fields": [
          {"field": "created_at", "descending": true},
          {"field": "category_slug", "ascending": true}
        ]}
      ]
    },
    {
      "name": "categories",
      "indexes": [
        {"field": "created_at"}
      ]
    }
  ]
}