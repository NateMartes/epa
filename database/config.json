{
  "collections": [
    {
      "name": "users",
      "indexes": [
        { "field": "user_id", "unique": true},
        {"field": "google_id", "unique": true, "sparse": true}
      ]
    },
    {
      "name": "session_tokens",
      "indexes": [
        {"field": "session_token", "expireAfterSeconds": 604800}
      ]
    },
    {
      "name": "posts",
      "indexes": [
        {"field": "created_at"},
        {"compound": true, "fields": [
          {"field": "created_at", "descending": true},
          {"field": "category_slug", "ascending": true}
        ]}
      ]
    },
    {
      "name": "categories",
      "init": [
        {
          "category_id": "test-1",
          "category_name": "Test"
        },
        {
          "category_id": "test-2",
          "category_name": "Test"
        },
        {
          "category_id": "test-3",
          "category_name": "Test"
        }
      ],
      "indexes": [
        {"field": "category_id", "unique": true}
      ]
    }
  ]
}